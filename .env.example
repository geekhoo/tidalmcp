# Keep this file public; create .env with your own secrets. Never commit .env.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
# Standard base64, exactly 32 random bytes. Generate with npm run keygen.
TOKEN_ENCRYPTION_KEY=
DATA_DIR=./var
# No trailing path: MCP is served at /mcp and TIDAL callback at /tidal/callback.
PUBLIC_ORIGIN=http://127.0.0.1:3000
LISTEN_HOST=127.0.0.1
PORT=3000
DEFAULT_COUNTRY=SG
# Operator opt-in plus per-grant scope plus explicit tool confirmation is required.
ENABLE_WRITES=false
# Exact client redirect URIs. For ChatGPT/Codex, use their actual current callback.
# Comma-separated. No wildcards; no untrusted dynamically supplied URLs.
OAUTH_REDIRECT_ALLOWLIST=http://127.0.0.1:8766/callback
# Explicit permitted browser origins, only if a browser client needs CORS.
ALLOWED_ORIGINS=
# Dedicated public UI origin recommended by a host may be supplied here.
WIDGET_DOMAIN=
# A local stdio account is established by npm run login; never pass tokens as arguments.
LOCAL_PROFILE=local
